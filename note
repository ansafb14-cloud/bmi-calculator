import 'package:flutter/material.dart';
import 'package:font_awesome_flutter/font_awesome_flutter.dart';

// --- Constants ---
const kActiveCardColor = Color(0xff111238);
const kInactiveCardColor = Color(0xff101427);
const kActiveIconColor = Color(0xffEA1556); // Color when selected
const kInactiveIconColor = Color(0xff8D8F9E); // Color when not selected
const kBottomContainerColor = Color(0xffEA1556);

const kLabelTextStyle = TextStyle(color: Color(0xff8D8F9E), fontSize: 18);
const kHeightTextStyle = TextStyle(color: Color(0xff8D8F9E), fontSize: 20);
const kNumberTextStyle = TextStyle(fontSize: 50, fontWeight: FontWeight.w900);

enum Gender { male, female }

class InputPage extends StatefulWidget {
  @override
  State<InputPage> createState() => _InputPageState();
}

class _InputPageState extends State<InputPage> {
  // Variable to track which gender is currently selected
  Gender? selectedGender;

  int height = 180;
  int weight = 60;
  int age = 19;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Center(child: Text('BMI CALCULATOR')),
        backgroundColor: Color(0xff0A0E21),
      ),
      // Added background color to scaffold to match the theme
      backgroundColor: Color(0xff0A0E21),
      body: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Expanded(
            child: Row(
              children: [
                // --- MALE CARD ---
                Expanded(
                  child: GestureDetector(
                    onTap: () {
                      setState(() {
                        selectedGender = Gender.male;
                      });
                    },
                    child: ReusableCard(
                      // If male is selected, use active color, else inactive
                      niram: selectedGender == Gender.male
                          ? kActiveCardColor
                          : kInactiveCardColor,
                      cardChild: Column(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          Icon(
                            FontAwesomeIcons.mars,
                            size: 80,
                            // CHANGE IS HERE: Change icon color based on selection
                            color: selectedGender == Gender.male
                                ? kActiveIconColor
                                : kInactiveIconColor,
                          ),
                          SizedBox(height: 15),
                          Text('MALE', style: kLabelTextStyle),
                        ],
                      ),
                    ),
                  ),
                ),

                // --- FEMALE CARD ---
                Expanded(
                  child: GestureDetector(
                    onTap: () {
                      setState(() {
                        selectedGender = Gender.female;
                      });
                    },
                    child: ReusableCard(
                      // If female is selected, use active color, else inactive
                      niram: selectedGender == Gender.female
                          ? kActiveCardColor
                          : kInactiveCardColor,
                      cardChild: Column(
                        mainAxisAlignment: MainAxisAlignment.center,
                        children: [
                          Icon(
                            FontAwesomeIcons.venus,
                            size: 80,
                            // CHANGE IS HERE: Change icon color based on selection
                            color: selectedGender == Gender.female
                                ? kActiveIconColor
                                : kInactiveIconColor,
                          ),
                          SizedBox(height: 15),
                          Text('FEMALE', style: kLabelTextStyle),
                        ],
                      ),
                    ),
                  ),
                ),
              ],
            ),
          ),

          // --- HEIGHT CARD ---
          Expanded(
            child: ReusableCard(
              niram: kActiveCardColor,
              cardChild: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Text('HEIGHT', style: kHeightTextStyle),
                  Row(
                    mainAxisAlignment: MainAxisAlignment.center,
                    crossAxisAlignment: CrossAxisAlignment.baseline,
                    textBaseline: TextBaseline.alphabetic,
                    children: [
                      Text(height.toString(), style: kNumberTextStyle),
                      Text('cm', style: kLabelTextStyle),
                    ],
                  ),
                  SliderTheme(
                    data: SliderTheme.of(context).copyWith(
                      thumbShape: RoundSliderThumbShape(enabledThumbRadius: 15),
                      overlayShape: RoundSliderOverlayShape(overlayRadius: 30),
                      thumbColor: Color(0xffEB1555),
                      activeTrackColor: Colors.white,
                      overlayColor: Color(0x29EB1555),
                      inactiveTrackColor: Color(0xff8D8E98),
                    ),
                    child: Slider(
                      value: height.toDouble(),
                      min: 120,
                      max: 220,
                      onChanged: (double newValue) {
                        setState(() {
                          height = newValue.round();
                        });
                      },
                    ),
                  ),
                ],
              ),
            ),
          ),

          // --- WEIGHT AND AGE CARDS ---
          Expanded(
            child: Row(
              children: [
                Expanded(
                  child: ReusableCard(
                    niram: kActiveCardColor,
                    cardChild: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Text('WEIGHT', style: kLabelTextStyle),
                        Text(weight.toString(), style: kNumberTextStyle),
                        Row(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            RoundIconButton(
                              icon: FontAwesomeIcons.minus,
                              onPressed: () {
                                setState(() {
                                  weight--;
                                });
                              },
                            ),
                            SizedBox(width: 10),
                            RoundIconButton(
                              icon: FontAwesomeIcons.plus,
                              onPressed: () {
                                setState(() {
                                  weight++;
                                });
                              },
                            ),
                          ],
                        ),
                      ],
                    ),
                  ),
                ),
                Expanded(
                  child: ReusableCard(
                    niram: kActiveCardColor,
                    cardChild: Column(
                      mainAxisAlignment: MainAxisAlignment.center,
                      children: [
                        Text('AGE', style: kLabelTextStyle),
                        Text(age.toString(), style: kNumberTextStyle),
                        Row(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            RoundIconButton(
                              icon: FontAwesomeIcons.minus,
                              onPressed: () {
                                setState(() {
                                  age--;
                                });
                              },
                            ),
                            SizedBox(width: 10),
                            RoundIconButton(
                              icon: FontAwesomeIcons.plus,
                              onPressed: () {
                                setState(() {
                                  age++;
                                });
                              },
                            ),
                          ],
                        )
                      ],
                    ),
                  ),
                ),
              ],
            ),
          ),

          // --- CALCULATE BUTTON ---
          Container(
            child: Center(
              child: Text(
                'CALCULATE',
                style: TextStyle(fontWeight: FontWeight.bold, fontSize: 25),
              ),
            ),
            margin: EdgeInsets.only(top: 10),
            padding: EdgeInsets.only(bottom: 20),
            color: kBottomContainerColor,
            width: double.infinity,
            height: 80,
          ),
        ],
      ),
    );
  }
}

// --- Custom Widgets ---

class ReusableCard extends StatelessWidget {
  ReusableCard({required this.niram, required this.cardChild});

  final Color niram;
  final Widget cardChild;

  @override
  Widget build(BuildContext context) {
    return Container(
      child: cardChild,
      margin: EdgeInsets.all(15),
      decoration: BoxDecoration(
        color: niram,
        borderRadius: BorderRadius.circular(10),
      ),
    );
  }
}

class RoundIconButton extends StatelessWidget {
  RoundIconButton({required this.icon, required this.onPressed});

  final IconData icon;
  final VoidCallback onPressed;

  @override
  Widget build(BuildContext context) {
    return RawMaterialButton(
      child: Icon(icon),
      onPressed: onPressed,
      elevation: 0,
      constraints: BoxConstraints.tightFor(
        width: 56.0,
        height: 56.0,
      ),
      shape: CircleBorder(),
      fillColor: Color(0xFF4C4F5E),
    );
  }
}









































